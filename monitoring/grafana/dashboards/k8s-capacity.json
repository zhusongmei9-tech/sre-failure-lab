{
  "uid": "sre-k8s-capacity",
  "title": "Kubernetes 商品查询容量",
  "schemaVersion": 39,
  "version": 1,
  "description": "在同一时间轴定位商品服务、Redis、CPU 配额及节点资源瓶颈。默认显示固定副本的容量实验。节点面板反映整台主机。",
  "tags": [
    "sre",
    "kubernetes",
    "capacity"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "namespace",
        "label": "实验命名空间",
        "query": "sre-capacity-lab,sre-app-lab",
        "current": {
          "text": "sre-capacity-lab",
          "value": "sre-capacity-lab"
        },
        "options": [
          {
            "selected": true,
            "text": "sre-capacity-lab",
            "value": "sre-capacity-lab"
          },
          {
            "selected": false,
            "text": "sre-app-lab",
            "value": "sre-app-lab"
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "商品 API 完成吞吐",
      "description": "服务端处理完成的请求。网络失败和压测机漏发见同一时段的 k6 报告。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_http_requests_total{namespace=\"${namespace}\",service=\"product-api\"}[1m]))",
          "legendFormat": "全部",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_http_requests_total{namespace=\"${namespace}\",service=\"product-api\",status_code!~\"2..\"}[1m]))",
          "legendFormat": "非 2xx",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum by (pod) (rate(lab_http_requests_total{namespace=\"${namespace}\",service=\"product-api\"}[1m]))",
          "legendFormat": "{{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "商品 API 服务端延迟",
      "description": "聚合所有 API Pod 的请求直方图，估算到响应头的耗时。对照压测机端到端 P95 / P99。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(lab_http_request_duration_seconds_bucket{namespace=\"${namespace}\",service=\"product-api\"}[1m])))",
          "legendFormat": "P95",
          "range": true
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(lab_http_request_duration_seconds_bucket{namespace=\"${namespace}\",service=\"product-api\"}[1m])))",
          "legendFormat": "P99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "每个 API Pod 的在途商品请求",
      "description": "每 10 秒采集一次当前处理数，短请求可能落在两次采样之间。均值以最近一分钟的总请求耗时除以窗口时长估算。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (lab_product_requests_in_flight{namespace=\"${namespace}\",service=\"product-api\"})",
          "legendFormat": "{{pod}} 采样值",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (rate(lab_http_request_duration_seconds_sum{namespace=\"${namespace}\",service=\"product-api\"}[1m]))",
          "legendFormat": "{{pod}} 一分钟均值",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API 等待 Redis 的 P95",
      "description": "按命令聚合应用侧等待时间，包括获取连接、网络往返和失败调用。无 SET 时段无样本。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, command) (rate(lab_product_redis_command_duration_seconds_bucket{namespace=\"${namespace}\",service=\"product-api\"}[1m])))",
          "legendFormat": "{{command}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pod CPU 用量",
      "description": "1,000 mCPU 等于一个逻辑核。结合节点空闲 CPU 和下一幅限流曲线查看容器配额。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * max by (pod, container) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"${namespace}\",container=~\"api|redis\",pod=~\"(product-api|redis)-.+\"}[2m]))",
          "legendFormat": "{{pod}} {{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mCPU",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pod CPU 限流时间",
      "description": "每个墙钟秒内累计受 CPU 配额限制的毫秒数。该内核计数可能跨 CPU 累计。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * max by (pod, container) (rate(container_cpu_cfs_throttled_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"${namespace}\",container=~\"api|redis\",pod=~\"(product-api|redis)-.+\"}[2m]))",
          "legendFormat": "{{pod}} {{container}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ms/s",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "节点空闲 CPU",
      "description": "按节点汇总各逻辑 CPU 的 idle 秒数增速。实验和同机其他工作负载均会影响该值。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[2m]))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 核",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "节点可用内存",
      "description": "Linux MemAvailable 对应的可用物理内存。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (node_memory_MemAvailable_bytes{job=\"node-exporter\"})",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "节点文件系统可用磁盘",
      "description": "每个本地文件系统可用字节数。查看系统根目录及存放容器数据的挂载点。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, device, mountpoint) (node_filesystem_avail_bytes{job=\"node-exporter\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|tracefs|proc|sysfs|cgroup2?|autofs\",mountpoint!~\"/run(/.*)?|.*/kubelet/pods/.*\"})",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "就绪 API 副本",
      "description": "实际就绪与配置副本数。按压测报告中的时间对照单副本和双副本窗口。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_status_replicas_ready{namespace=\"${namespace}\",deployment=\"product-api\"})",
          "legendFormat": "就绪",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(kube_deployment_spec_replicas{namespace=\"${namespace}\",deployment=\"product-api\"})",
          "legendFormat": "配置",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "商品缓存结果",
      "description": "按每次商品请求的缓存结果划分。冷启动实验关注首个 MISS，再观察后续 HIT。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(lab_cache_requests_total{namespace=\"${namespace}\",service=\"product-api\"}[1m]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
