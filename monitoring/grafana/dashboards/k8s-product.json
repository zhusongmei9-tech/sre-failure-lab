{
  "uid": "sre-k8s-product",
  "title": "Kubernetes 商品 API 发布与扩缩容",
  "description": "sre-app-lab 的商品服务。业务指标来自 API，容器 CPU 来自 kubelet，副本状态来自 kube-state-metrics。",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "tags": [
    "sre",
    "kubernetes",
    "product-api"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "商品请求速率",
      "description": "每秒完成的商品请求数，按最近一分钟计算。失败包括 429 和其他非 2xx 响应。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lab_http_requests_total{namespace=\"sre-app-lab\",service=\"product-api\"}[1m]))",
          "legendFormat": "全部",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(lab_http_requests_total{namespace=\"sre-app-lab\",service=\"product-api\",status_code!~\"2..\"}[1m]))",
          "legendFormat": "失败",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "无数据",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "商品请求 P95",
      "description": "按最近一分钟的所有 API 副本直方图估算服务端响应头耗时。没有商品请求时该值无定义。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(lab_http_request_duration_seconds_bucket{namespace=\"sre-app-lab\",service=\"product-api\"}[1m])))",
          "legendFormat": "服务端 P95",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "无数据",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Pod CPU 用量",
      "description": "最近两分钟的平均 CPU 用量，1000 mCPU 等于一个逻辑核。HPA 根据 Metrics Server 的独立采样作出伸缩决定。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * max by (pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"sre-app-lab\",container=\"api\",pod=~\"product-api-.+\"}[2m]))",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: mCPU",
          "min": 0,
          "noValue": "无数据",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "发布与伸缩副本",
      "description": "Deployment 就绪副本与 HPA 记录的当前和期望副本。发布时旧副本和新副本可能短暂并存。",
      "datasource": {
        "type": "prometheus",
        "uid": "kubernetes"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_deployment_status_replicas_ready{namespace=\"sre-app-lab\",deployment=\"product-api\"})",
          "legendFormat": "Deployment 就绪",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"sre-app-lab\",horizontalpodautoscaler=\"product-api\"})",
          "legendFormat": "HPA 当前",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"sre-app-lab\",horizontalpodautoscaler=\"product-api\"})",
          "legendFormat": "HPA 期望",
          "datasource": {
            "type": "prometheus",
            "uid": "kubernetes"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "无数据",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
