# Default: accessible only inside the VM via localhost.
# Set API_BIND_HOST=0.0.0.0 to access from the host machine on a trusted lab network.
API_BIND_HOST=127.0.0.1
API_PORT=8000
CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_SECONDS=0.5
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
LOAD_RPS=10
LOAD_WORKERS=10
FALLBACK_ENABLED=false
# Required: generate locally; no working default credential is shipped.
LAB_TOKEN=

# Bounded API resources for CPU experiments (Docker Compose).
API_CPUS=1.0
API_MEMORY_LIMIT=256m
